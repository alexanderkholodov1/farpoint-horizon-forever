{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9]{4,6}$/)",
        ".write": "$code.matches(/^[A-Z0-9]{4,6}$/)",
        "host": {
          ".validate": "newData.isString() && newData.val().length <= 40 && (!data.exists() || data.val() === newData.val())"
        },
        "created": {
          ".validate": "newData.isNumber()"
        },
        "state": {
          ".validate": "newData.isString() && newData.val().length <= 20000"
        },
        "members": {
          "$pid": {
            ".validate": "$pid.length <= 40 && newData.hasChildren(['name', 'seen'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "seen": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "ops": {
          "$op": {
            ".validate": "newData.hasChildren(['by', 'j', 't'])",
            "by": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "j": { ".validate": "newData.isString() && newData.val().length <= 4000" },
            "t": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
