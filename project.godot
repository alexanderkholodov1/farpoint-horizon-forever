; Engine configuration file.
; Farpoint HORIZON
; NASA Space Apps Challenge 2026 - Space Mission Design Game

config_version=5

[application]

config/name="Farpoint HORIZON"
config/description="A 3D game to design, launch and operate a complete space mission."
config/version="dev"
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.008, 0.02, 0.043, 1)
boot_splash/image="res://assets/brand/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
run/flush_stdout_on_print=true
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameData="*res://scripts/core/game_data.gd"
GameState="*res://scripts/core/game_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/fallback="en"
locale/translations=PackedStringArray("res://i18n/translations.es.translation")

[rendering]

textures/default_filters/anisotropic_filtering_level=3

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

